# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Required in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in production with a short key or one of this repo's placeholders.
SECRET_KEY=
POSTGRES_PASSWORD=app
# For a real deployment:
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-frontend.example.com
# PUBLIC_API_URL=https://api.your-domain.example.com
# FORWARDED_ALLOW_IPS=10.0.0.5          # your load balancer, so rate limits see client IPs
# SENTRY_DSN=https://...                # error tracking (optional)
# LLM_ALLOWED_MODELS=claude-sonnet-5-5  # extra models users may pick (LLM_MODEL is always allowed)
# DAILY_TOKEN_BUDGET_PER_USER=1000000   # 0 disables the budget
