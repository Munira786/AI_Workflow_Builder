# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=app
