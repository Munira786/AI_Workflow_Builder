# Copy to backend/.env for local development (without Docker).
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dev.db
# REDIS_URL=redis://localhost:6379/0   # leave unset to run pipelines in-process
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
CORS_ORIGINS=http://localhost:3000
# Read from this file by the app (the Anthropic SDK alone would only see real env vars).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# LLM_ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5
# LOG_FORMAT=json                      # default: json in production, text otherwise
# SENTRY_DSN=
